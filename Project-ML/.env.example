# 必填：阿里云百炼 API Key。禁止把真实 Key 提交到 Git。
DASHSCOPE_API_KEY=

# 模型配置
QWEN_MODEL=qwen3.7-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_MODEL=paraformer-realtime-v2
DASHSCOPE_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ASR_LANGUAGE_HINTS=zh,en

# 若使用百炼业务空间专属域名，可替换为：
# DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_WEBSOCKET_URL=wss://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference

# FFmpeg 不在 PATH 时填写可执行文件的绝对路径
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# 优先 H.264，便于 OpenCV 快速抽帧；不可用时回退到最佳格式
YTDLP_FORMAT=bv*[vcodec^=avc1]+ba/b[vcodec^=avc1]/bv*+ba/b

# 人名、歌名、机构名等专名的联网核验
ENTITY_VERIFY_ENABLED=true
ENTITY_VERIFY_MODEL=qwen-plus
ENTITY_VERIFY_SEARCH_STRATEGY=turbo
ENTITY_VERIFY_MIN_CONFIDENCE=0.85
ENTITY_VERIFY_MAX_ENTITIES=20
ENTITY_GLOSSARY_PATH=entity_glossary.json

# 流程参数
VIDEO_ASSISTANT_OUTPUT_DIR=runs
SEGMENT_SECONDS=60
MAX_PARALLEL_SEGMENT_ANALYSES=4
FRAME_SCAN_INTERVAL_SECONDS=1
PERIODIC_FRAME_SECONDS=30
MIN_SCENE_GAP_SECONDS=8
SCENE_THRESHOLD=0.22
MAX_TOTAL_FRAMES=500
MAX_IMAGES_PER_SEGMENT=8
IMAGE_MAX_WIDTH=1280
MODEL_REQUEST_TIMEOUT_SECONDS=180
DOWNLOAD_ATTEMPTS=3
DOWNLOAD_RETRIES_PER_ATTEMPT=2
DOWNLOAD_SOCKET_TIMEOUT_SECONDS=60
FAST_SUMMARY_ENABLED=false
FAST_SUMMARY_MODEL=qwen3.7-flash
FAST_SUMMARY_MAX_TRANSCRIPT_CHARS=24000
FAST_ASR_MODEL=qwen3-asr-flash
FAST_ASR_CHUNK_SECONDS=180
FAST_ASR_PARALLELISM=4
