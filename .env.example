# Application
APP_ENV=development
APP_SECRET=replace-with-a-long-random-value
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_PORT=8000

# MongoDB / Redis (Docker Compose defaults)
MONGO_INITDB_ROOT_USERNAME=video_devour
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGODB_URL=mongodb://video_devour:change-me@mongo:27017/video_devour?authSource=admin
MONGODB_DATABASE=video_devour
REDIS_URL=redis://redis:6379/0

# File retention and upload controls
TASK_STORAGE_ROOT=/data/tasks
MAX_UPLOAD_BYTES=2147483648
TASK_RETENTION_DAYS=14

# Project-ML / DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
QWEN_MODEL=qwen3.7-plus
ASR_MODEL=paraformer-realtime-v2
SEGMENT_SECONDS=90
MAX_PARALLEL_SEGMENT_ANALYSES=2
ENTITY_VERIFY_ENABLED=true
DOWNLOAD_ATTEMPTS=3
DOWNLOAD_RETRIES_PER_ATTEMPT=2
DOWNLOAD_SOCKET_TIMEOUT_SECONDS=60
FAST_SUMMARY_ENABLED=false
FAST_SUMMARY_MODEL=qwen3.7-flash
FAST_SUMMARY_MAX_TRANSCRIPT_CHARS=24000
FAST_ASR_MODEL=qwen3-asr-flash
FAST_ASR_CHUNK_SECONDS=180
FAST_ASR_PARALLELISM=4

# Docker 镜像内已安装 FFmpeg；本地 Windows 调试时可改为绝对路径。
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
